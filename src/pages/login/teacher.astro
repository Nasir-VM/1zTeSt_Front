---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="教師登入">
    <main class="relative flex min-h-screen items-center justify-center" style="background: #faf8f5;">
      <div class="dot-grid absolute inset-0 opacity-20 pointer-events-none"></div>
      <div class="relative w-full max-w-sm px-6">
        <div class="mb-10 text-center">
          <a href="/" class="font-logo text-3xl" style="color: #1c1917;">1zTeSt</a>
          <p class="font-serif mt-2 text-base" style="color: #78716c;">教師登入</p>
        </div>
        <div class="border-l-2 pl-6" style="border-color: #d6d3d1;">
          <div id="logged-in-info" class="hidden text-center">
            <p class="text-sm" style="color: #78716c;">歡迎，<span id="user-display-name" class="font-bold" style="color: #1c1917;"></span></p>
            <a id="go-to-panel" href="/teacher/" class="btn-primary mt-5 inline-block">前往教師後台</a>
            <button id="logout-btn" class="mt-4 block w-full text-center text-sm transition hover:text-red-500" style="color: #a8a29e;">登出</button>
          </div>
          <div id="login-area">
            <button id="btn-google" class="group flex w-full items-center justify-center gap-3.5 rounded-2xl border border-stone-200 bg-white px-6 py-3.5 text-base font-semibold text-stone-700 shadow-sm transition-all duration-200 hover:border-stone-300 hover:bg-stone-50/90 hover:shadow-md active:scale-[0.98]">
              <svg class="h-5 w-5 shrink-0 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
              <span>繼續使用 Google</span>
            </button>
            <p id="login-error" class="mt-4 hidden text-center text-sm text-red-500"></p>
          </div>
          <div class="mt-8 pt-6 text-center" style="border-top: 1px solid #e7e5e4;">
            <a href="/" class="text-sm transition hover:text-green-600" style="color: #a8a29e;">← 回到首頁</a>
          </div>
        </div>
      </div>
    </main>
</Layout>

<script is:inline>
const BP = (typeof window !== 'undefined' && window.BASE_PATH) ? window.BASE_PATH : '';

/* ── Fast path: already logged in as teacher → redirect immediately ── */
const _u = JSON.parse(localStorage.getItem('fb_user') || 'null');
if (_u && _u.email && _u.role === 'teacher') {
  window.location.href = BP + '/teacher/';
} else {

function hideEl(id) { const e = document.getElementById(id); if (e) e.classList.add('hidden'); }
function showEl(id) { const e = document.getElementById(id); if (e) e.classList.remove('hidden'); }
function setText(id, t) { const e = document.getElementById(id); if (e) e.textContent = t; }
function showErr(msg) { setText('login-error', msg); showEl('login-error'); }

firebase.auth().onAuthStateChanged(async (user) => {
  if (user) {
    const email = user.email;
    const sanitized = window.sanitizeEmail(email);

    const [wlSnap, teacherSnap] = await Promise.all([
      firebase.database().ref('config/teacherWhitelist/' + sanitized).once('value'),
      firebase.database().ref('1zTeStsys/Teacheraccount/' + sanitized).once('value')
    ]);

    if (!wlSnap.exists()) {
      hideEl('login-area');
      showEl('logged-in-info');
      setText('user-display-name', email);
      document.getElementById('login-error') && (document.getElementById('login-error').textContent = '此帳號未被授權為教師');
      document.getElementById('login-error') && document.getElementById('login-error').classList.remove('hidden');
      return;
    }

    if (!teacherSnap.exists()) {
      await firebase.database().ref('1zTeStsys/Teacheraccount/' + sanitized).set({ email: email });
    }

    localStorage.setItem('fb_user', JSON.stringify({ email, name: user.displayName, role: 'teacher' }));
    window.location.href = BP + '/teacher/';
  }
});

} /* end else - not already logged in */

document.getElementById('btn-google').addEventListener('click', async () => {
  hideEl('login-error');
  try {
    const provider = new firebase.auth.GoogleAuthProvider();
    provider.addScope('email');
    provider.addScope('profile');
    await firebase.auth().signInWithPopup(provider);
  } catch (e) {
    if (e.code === 'auth/popup-closed-by-user') return;
    showErr('登入失敗：' + (e.message || e));
  }
});

document.getElementById('logout-btn')?.addEventListener('click', async () => {
  try { await firebase.auth().signOut(); } catch (e) {  }
  localStorage.removeItem('fb_user');
  localStorage.removeItem('last_activity');
  location.reload();
});
</script>
