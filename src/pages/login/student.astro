---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="學生登入">
  <main class="relative flex min-h-screen items-center justify-center" style="background: #fcfcfd;">
    <div class="blur-circle right-[-5%] top-[-5%] h-[350px] w-[350px] bg-green-400/10"></div>
    <div class="blur-circle bottom-[-5%] left-[-5%] h-[300px] w-[300px] bg-emerald-400/10"></div>
    <div class="dot-grid absolute inset-0 opacity-30 pointer-events-none"></div>
    <div class="relative w-full max-w-md px-6">
      <div class="mb-8 text-center">
        <a href="/" class="font-logo text-3xl" style="color: var(--color-primary);">1zTeSt</a>
        <p class="font-script mt-1 text-lg text-slate-400">學生登入</p>
      </div>
      <div class="card card-shadow p-8">
        <div id="logged-in-info" class="hidden text-center">
          <p class="text-slate-500">歡迎，<span id="user-display-name" class="font-bold" style="color: var(--color-primary);"></span></p>
          <a id="go-to-panel" href="/quiz/" class="btn-primary mt-4">前往測驗</a>
          <button id="logout-btn" class="mt-3 block w-full text-center text-sm text-slate-400 hover:text-red-500">登出</button>
        </div>
        <div id="login-area">
          <button id="btn-google" class="group flex w-full items-center justify-center gap-3.5 rounded-2xl border border-slate-200/90 bg-white px-6 py-3.5 text-base font-semibold text-slate-700 shadow-sm transition-all duration-200 hover:border-slate-300 hover:bg-slate-50/90 hover:shadow-md active:scale-[0.98]">
            <svg class="h-5 w-5 shrink-0 transition-transform duration-200 group-hover:scale-110" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
            <span>以 Google 帳號登入</span>
          </button>
          <p id="login-error" class="mt-4 hidden text-center text-sm text-red-500"></p>
        </div>
        <div class="mt-6 border-t border-slate-100 pt-4 text-center">
          <a href="/" class="text-sm text-slate-400 transition hover:text-green-600">← 回到首頁</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script is:inline>
const BP = (typeof window !== 'undefined' && window.BASE_PATH) ? window.BASE_PATH : '';

/* ── Fast path: already logged in as student → skip Firebase wait ── */
const _u = JSON.parse(localStorage.getItem('fb_user') || 'null');
if (_u && _u.email && _u.role === 'student') {
  window.location.href = BP + '/quiz/';
} else {

function hideEl(id) { const e = document.getElementById(id); if (e) e.classList.add('hidden'); }
function showEl(id) { const e = document.getElementById(id); if (e) e.classList.remove('hidden'); }
function setText(id, t) { const e = document.getElementById(id); if (e) e.textContent = t; }
function showErr(msg) { setText('login-error', msg); showEl('login-error'); }

firebase.auth().onAuthStateChanged(async (user) => {
  if (user) {
    const sanitized = window.sanitizeEmail(user.email);
    const snap = await firebase.database().ref('1zTeStsys/Studentaccount/' + sanitized).once('value');
    const profile = snap.val();

    hideEl('login-area');
    showEl('logged-in-info');
    setText('user-display-name', profile ? (profile.name || user.email) : user.displayName || user.email);

    const goToPanel = document.getElementById('go-to-panel');
    if (goToPanel) goToPanel.href = BP + '/quiz/';

    if (profile && profile.name && profile.stunum) {
      
    } else {
      window.location.href = BP + '/login/setup';
      return;
    }

    localStorage.setItem('fb_user', JSON.stringify({ email: user.email, name: profile ? profile.name : user.displayName, role: 'student' }));
  }
});

} /* end else - not already logged in */

document.getElementById('btn-google').addEventListener('click', async () => {
  hideEl('login-error');
  try {
    const provider = new firebase.auth.GoogleAuthProvider();
    provider.addScope('email');
    provider.addScope('profile');

    await firebase.auth().signInWithPopup(provider);
  } catch (e) {
    if (e.code === 'auth/popup-closed-by-user') return;
    showErr('登入失敗：' + (e.message || e));
  }
});

document.getElementById('logout-btn')?.addEventListener('click', async () => {
  try { await firebase.auth().signOut(); } catch (e) {  }
  localStorage.removeItem('fb_user');
  localStorage.removeItem('last_activity');
  location.reload();
});
</script>
