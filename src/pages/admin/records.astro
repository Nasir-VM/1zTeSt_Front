---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="成績管理">
  <div id="auth-guard" style="position:fixed;inset:0;z-index:9999;background:#fff;display:flex;align-items:center;justify-content:center"></div>

  <!-- Top Navbar -->
  <nav class="topnav">
    <div class="topnav-inner">
      <div class="topnav-left">
        <a href="/" class="topnav-logo">1zTeSt</a>
        <span class="topnav-divider"></span>
        <span class="topnav-subtitle">管理後台</span>
      </div>
      <div class="topnav-tabs">
        <a href="/admin/home" class="topnav-tab">總覽</a>
        <a href="/admin/questions" class="topnav-tab">題目</a>
        <a href="/admin/records" class="topnav-tab active">成績</a>
        <a href="/ttvs/admin" class="topnav-tab">TTVS</a>
        <a href="/" class="topnav-tab">回首頁</a>
      </div>
      <div class="topnav-right">
        <div class="profile-menu">
          <button id="profile-trigger" class="profile-btn">
            <div id="avatar-circle" class="avatar"></div>
            <svg class="chevron" id="profile-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
          </button>
          <div id="profile-dropdown" class="dropdown">
            <div class="dropdown-head">
              <p class="dropdown-label">管理員</p>
              <p id="dropdown-email" class="dropdown-email"></p>
            </div>
            <button id="dropdown-logout" class="dropdown-item danger">登出</button>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Content -->
  <main class="main-content w-full flex-1">
    <div class="section-bar">
      <h2 class="section-title">成績管理</h2>
      <span class="section-count">瀏覽與編輯所有成績</span>
    </div>

    <!-- Data source tabs -->
    <div class="flex items-center gap-2 mb-6 border-b border-slate-200 pb-3">
      <button data-src="quiz" class="src-tab active">QUIZSCORES 一般測驗</button>
      <button data-src="pvqc" class="src-tab">PVQCSCORES TTVS 成績</button>
    </div>

    <!-- QUIZSCORES panel -->
    <section id="panel-quiz" class="panel p-5 mb-6 border border-slate-200 shadow-sm bg-white" style="border-radius:0px;">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-200 flex-wrap gap-3">
        <div>
          <h2 class="text-sm font-bold text-slate-800">一般測驗成績</h2>
          <p class="text-xs text-slate-500 mt-0.5">教師 → 日期 → 學生 → 作答紀錄（點擊展開）</p>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <input id="quiz-search" type="text" placeholder="搜尋學生/姓名..." class="border border-slate-200 px-3 py-2 text-xs text-slate-700 focus:border-slate-800 focus:outline-none flex-1 sm:w-56" style="border-radius:0px;" />
          <button id="btn-expand-all-quiz" class="text-xs font-semibold px-3 py-2 border border-slate-300 bg-white text-slate-600 hover:bg-slate-50 transition" style="border-radius:0px;">全部展開</button>
          <button id="btn-collapse-all" class="text-xs font-semibold px-3 py-2 border border-slate-300 bg-white text-slate-600 hover:bg-slate-50 transition" style="border-radius:0px;">全部收合</button>
        </div>
      </div>
      <div id="quiz-tree" class="space-y-3"></div>
      <p id="quiz-empty" class="hidden py-8 text-center text-sm text-slate-400">尚無測驗成績</p>
    </section>

    <!-- PVQCSCORES panel -->
    <section id="panel-pvqc" class="panel p-5 mb-6 border border-slate-200 shadow-sm bg-white hidden" style="border-radius:0px;">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-200 flex-wrap gap-3">
        <div>
          <h2 class="text-sm font-bold text-slate-800">TTVS 成績</h2>
          <p class="text-xs text-slate-500 mt-0.5">_ttvs 教師即時成績　・　教師遷移成績（日期 → 學生 → 類別）</p>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <input id="pvqc-search" type="text" placeholder="搜尋學生/姓名..." class="border border-slate-200 px-3 py-2 text-xs text-slate-700 focus:border-slate-800 focus:outline-none flex-1 sm:w-56" style="border-radius:0px;" />
          <button id="btn-expand-all-pvqc" class="text-xs font-semibold px-3 py-2 border border-slate-300 bg-white text-slate-600 hover:bg-slate-50 transition" style="border-radius:0px;">全部展開</button>
          <button id="btn-collapse-all-pvqc" class="text-xs font-semibold px-3 py-2 border border-slate-300 bg-white text-slate-600 hover:bg-slate-50 transition" style="border-radius:0px;">全部收合</button>
        </div>
      </div>
      <div id="pvqc-tree" class="space-y-3"></div>
      <p id="pvqc-empty" class="hidden py-8 text-center text-sm text-slate-400">尚無 TTVS 成績</p>
    </section>
  </main>

  <div id="toast" class="toast-wrap"></div>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap');
  /* ── Reset & Base ── */
  :root { --black: #111; --gray-1: #333; --gray-2: #666; --gray-3: #999; --gray-4: #ccc; --gray-bg: #f5f5f5; --white: #fff; --border: #e5e5e5; --radius: 12px; }
  body { font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif; }

  /* ── Top Nav ── */
  .topnav { position: sticky; top: 0; z-index: 40; background: rgba(255,255,255,0.92); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); }
  .topnav-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; height: 56px; padding: 0 24px; }
  .topnav-left { display: flex; align-items: center; gap: 12px; }
  .topnav-logo { font-size: 18px; font-weight: 700; color: var(--black); text-decoration: none; letter-spacing: -0.02em; }
  .topnav-divider { width: 1px; height: 18px; background: var(--gray-4); }
  .topnav-subtitle { font-size: 13px; color: var(--gray-3); font-weight: 500; }
  .topnav-tabs { display: flex; align-items: center; gap: 8px; }
  .topnav-tab {
    position: relative;
    font-size: 13px;
    font-weight: 500;
    color: var(--gray-3, #64748b);
    background: transparent;
    border: none;
    padding: 16px 10px;
    cursor: pointer;
    transition: color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .topnav-tab::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2.5px;
    background: #16a34a;
    border-radius: 9999px;
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .topnav-tab:hover { color: #16a34a; }
  .topnav-tab:hover::after { width: 100%; left: 0; }
  .topnav-tab.active { color: #16a34a; font-weight: 600; }
  .topnav-tab.active::after { width: 100%; left: 0; }
  .topnav-right { display: flex; align-items: center; gap: 16px; }
  .profile-menu { position: relative; }
  .profile-btn { display: flex; align-items: center; gap: 8px; cursor: pointer; background: none; border: none; padding: 4px 8px; border-radius: 8px; transition: background 0.15s; }
  .profile-btn:hover { background: var(--gray-bg); }
  .avatar { width: 30px; height: 30px; border-radius: 8px; background: var(--black); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; overflow: hidden; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .chevron { width: 14px; height: 14px; color: var(--gray-4); transition: transform 0.2s; }
  .chevron.open { transform: rotate(180deg); }
  .dropdown { position: absolute; right: 0; top: calc(100% + 8px); width: 240px; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); box-shadow: 0 8px 32px rgba(0,0,0,0.08); opacity: 0; pointer-events: none; transform: translateY(-4px); transition: all 0.2s cubic-bezier(0.16,1,0.3,1); }
  .dropdown.open { opacity: 1; pointer-events: auto; transform: translateY(0); }
  .dropdown-head { padding: 14px 16px; border-bottom: 1px solid var(--border); }
  .dropdown-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gray-3); }
  .dropdown-email { margin-top: 2px; font-size: 13px; font-weight: 500; color: var(--gray-1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dropdown-item { display: block; width: 100%; text-align: left; padding: 10px 16px; font-size: 13px; color: var(--gray-2); background: none; border: none; cursor: pointer; transition: background 0.15s; }
  .dropdown-item:hover { background: var(--gray-bg); }
  .dropdown-item.danger { color: #e53e3e; }
  .dropdown-item.danger:hover { background: #fff5f5; }

  /* ── Main Content ── */
  .main-content { max-width: 1200px; margin: 0 auto; padding: 32px 24px; }

  /* ── Section Bar ── */
  .section-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .section-title { font-size: 15px; font-weight: 600; color: var(--black); }
  .section-count { font-size: 12px; color: var(--gray-3); }

  /* ── Source tabs (underline style, matches topnav) ── */
  .src-tab { padding: 7px 14px; font-size: 13px; font-weight: 500; color: var(--gray-2); background: transparent; border: none; cursor: pointer; transition: color 0.15s, border-color 0.15s; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .src-tab:hover { color: #16a34a; }
  .src-tab.active { color: #16a34a; border-bottom-color: #16a34a; font-weight: 600; }

  /* ── Panel ── */
  .panel { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: box-shadow 0.2s; }
  .panel:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.04); }
  .panel.p-5 { padding: 20px; }

  /* ── Tree ── */
  .tree-node { border: 1px solid var(--border); background: #fff; }
  .node-head { display: flex; align-items: center; gap: 12px; padding: 12px 16px; cursor: pointer; user-select: none; }
  .node-head:hover { background: var(--gray-bg); }
  .node-icon { display: flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 6px; flex-shrink: 0; font-size: 12px; color: #fff; }
  .node-icon.k-teacher { background: #1f2937; }
  .node-icon.k-date { background: #16a34a; }
  .node-icon.k-student { background: #2563eb; }
  .node-icon.k-attempt { background: #d97706; }
  .node-main { flex: 1; min-width: 0; }
  .node-title { font-size: 13px; font-weight: 600; color: var(--gray-1); word-break: break-all; }
  .node-meta { font-size: 11px; color: var(--gray-3); margin-top: 1px; }
  .node-children { border-top: 1px solid #f3f4f6; margin: 0 0 0 22px; padding: 10px 0 10px 18px; border-left: 2px solid #e5e5e5; background: #fcfcfc; display: flex; flex-direction: column; gap: 6px; }
  .caret { display: inline-block; width: 16px; height: 16px; flex-shrink: 0; color: #94a3b8; transition: transform 0.15s; }
  .caret.open { transform: rotate(90deg); }

  /* ── Score rows ── */
  .score-row { display: flex; align-items: center; gap: 12px; padding: 9px 12px; background: #fff; border: 1px solid #eef0f2; border-radius: 8px; transition: border-color 0.15s, box-shadow 0.15s; }
  .score-row:hover { border-color: #d6d3d1; box-shadow: 0 1px 4px rgba(0,0,0,0.04); }
  .score-badge { display: flex; flex-direction: column; align-items: center; justify-content: center; min-width: 52px; padding: 6px 8px; background: #f0fdf4; border: 1px solid #dcfce7; border-radius: 8px; flex-shrink: 0; }
  .score-badge-num { font-size: 14px; font-weight: 700; color: #15803d; line-height: 1.1; font-variant-numeric: tabular-nums; }
  .score-badge-total { font-size: 9px; color: #86b79a; line-height: 1.2; }
  .score-info { flex: 1; min-width: 0; }
  .score-name { font-size: 13px; font-weight: 600; color: #111; }
  .score-sub { font-size: 11px; color: #999; margin-top: 1px; word-break: break-all; }
  .score-actions { display: flex; gap: 6px; flex-shrink: 0; }
  .btn-mini { padding: 4px 10px; font-size: 11px; font-weight: 600; cursor: pointer; transition: all 0.15s; border-radius: 6px; }
  .btn-mini.green { background: #16a34a; color: #fff; border: 1px solid #16a34a; }
  .btn-mini.green:hover { background: #15803d; }
  .btn-mini.red { background: #fff; color: #dc2626; border: 1px solid #fca5a5; }
  .btn-mini.red:hover { background: #fff5f5; }

  .no-match { padding: 20px; text-align: center; font-size: 12px; color: #999; background: #fff; border: 1px dashed var(--border); }

  /* ── Toast ── */
  .toast-wrap { position: fixed; bottom: 24px; right: 24px; z-index: 50; display: flex; flex-direction: column; gap: 8px; }
  .toast-item { padding: 12px 20px; border-radius: 10px; background: var(--black); color: #fff; font-size: 13px; font-weight: 500; box-shadow: 0 8px 32px rgba(0,0,0,0.12); animation: toastIn 0.3s cubic-bezier(0.16,1,0.3,1) forwards; }
  .toast-item.out { animation: toastOut 0.2s forwards; }
  @keyframes toastIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes toastOut { from { opacity: 1; } to { opacity: 0; transform: translateY(8px); } }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .topnav-inner { padding: 0 16px; height: 50px; }
    .topnav-subtitle { display: none; }
    .topnav-divider { display: none; }
    .topnav-tabs { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; flex-shrink: 1; min-width: 0; }
    .topnav-tabs::-webkit-scrollbar { display: none; }
    .topnav-tab { white-space: nowrap; padding: 6px 10px; font-size: 12px; }
    .topnav-right { gap: 8px; }
    .main-content { padding: 20px 16px; }
    .score-actions { flex-direction: column; }
  }
</style>

<script is:inline>
const BP = (typeof window !== 'undefined' && window.BASE_PATH) ? window.BASE_PATH : '';
const user = JSON.parse(localStorage.getItem('fb_user') || 'null');
if (!user || !user.email || !window.isAdminEmail(user.email)) {
  window.location.href = BP + '/admin/login';
} else {
  document.getElementById('auth-guard')?.remove();
}

const avatarEl = document.getElementById('avatar-circle');
const dropdownEmail = document.getElementById('dropdown-email');
if (user?.email) {
  if (user.photoURL) {
    avatarEl.innerHTML = '<img src="' + user.photoURL + '" alt="avatar" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />';
  } else {
    avatarEl.textContent = user.email[0].toUpperCase();
  }
  dropdownEmail.textContent = user.email;
}
let ddOpen = false;
const dd = document.getElementById('profile-dropdown');
const chev = document.getElementById('profile-chevron');
document.getElementById('profile-trigger')?.addEventListener('click', e => { e.stopPropagation(); ddOpen = !ddOpen; dd.classList.toggle('open', ddOpen); chev.classList.toggle('open', ddOpen); });
document.addEventListener('click', () => { if (ddOpen) { ddOpen = false; dd.classList.remove('open'); chev.classList.remove('open'); } });
dd?.addEventListener('click', e => e.stopPropagation());
document.getElementById('dropdown-logout')?.addEventListener('click', async () => {
  try { await window.fbAuth.signOut(); } catch(e) {}
  localStorage.removeItem('fb_user'); localStorage.removeItem('last_activity');
  window.location.href = BP + '/';
});

function showToast(msg) {
  const w = document.getElementById('toast');
  const el = document.createElement('div');
  el.className = 'toast-item'; el.textContent = msg;
  w.appendChild(el);
  setTimeout(() => { el.classList.add('out'); setTimeout(() => el.remove(), 220); }, 2800);
}

function esc(s) {
  if (s === null || s === undefined) return '';
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

const db = window.fbDB;
let quizData = null;
let pvqcData = null;

/* ── Tab switching ── */
document.querySelectorAll('.src-tab').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.src-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    const isQuiz = btn.dataset.src === 'quiz';
    document.getElementById('panel-quiz').classList.toggle('hidden', !isQuiz);
    document.getElementById('panel-pvqc').classList.toggle('hidden', isQuiz);
  });
});

/* ══════════ QUIZSCORES ══════════ */
async function loadQuiz() {
  const snap = await db.ref('QUIZSCORES').once('value');
  quizData = snap.exists() ? snap.val() : null;
  renderQuiz();
}

function quizScorePath(teacherKey, dateKey, studentSan, attemptKey, innerKey) {
  let p = 'QUIZSCORES/' + teacherKey + '/' + dateKey + '/' + studentSan + '/' + attemptKey;
  if (innerKey) p += '/' + innerKey;
  return p;
}

async function editScore(path, cache, refresh) {
  const { value: v } = await Swal.fire({
    title: '輸入新分數',
    text: '目前：' + (cache && cache.score != null ? cache.score + (cache.total != null ? ' / ' + cache.total : '') : '-'),
    input: 'number',
    inputAttributes: { min: '0', step: '1' },
    inputValue: cache && cache.score != null ? cache.score : '',
    showCancelButton: true,
    confirmButtonText: '儲存',
    cancelButtonText: '取消',
    confirmButtonColor: '#16a34a'
  });
  if (v === null || v === undefined || v === '') return;
  try {
    await db.ref(path + '/score').set(Number(v));
    if (cache) cache.score = Number(v);
    showToast('已更新分數為 ' + v);
    if (refresh) refresh();
  } catch (e) { showToast('更新失敗'); console.error(e); }
}

async function deleteRecord(path, name, refresh) {
  if (!confirm('確定刪除 ' + (name || '這筆') + ' 的成績？此操作無法復原！')) return;
  try {
    await db.ref(path).remove();
    showToast('已刪除紀錄');
    if (refresh) refresh();
  } catch (e) { showToast('刪除失敗'); console.error(e); }
}

function renderQuiz() {
  const tree = document.getElementById('quiz-tree');
  tree.replaceChildren();
  if (!quizData || !Object.keys(quizData).length) {
    document.getElementById('quiz-empty').classList.remove('hidden');
    return;
  }
  document.getElementById('quiz-empty').classList.add('hidden');
  const q = (document.getElementById('quiz-search').value || '').trim().toLowerCase();
  const forceOpen = !!q;

  Object.keys(quizData).sort().forEach(teacherKey => {
    const teacherDisplay = teacherKey.replace(/,/g, '.');
    const datesAll = Object.keys(quizData[teacherKey] || {}).sort().reverse();
    const teacherNode = buildNode('teacher', teacherDisplay, '教師', (box) => {
      datesAll.forEach(dateKey => {
        const studentsAll = Object.keys(quizData[teacherKey][dateKey] || {}).sort();
        const studentsMatch = q ? studentsAll.filter(s => {
          const attempts = quizData[teacherKey][dateKey][s] || {};
          return s.toLowerCase().includes(q) || Object.keys(attempts).some(k => {
            const v = attempts[k];
            const recs = v && v.score !== undefined ? [v] : Object.values(v || {});
            return recs.some(r => (r.name || '').toLowerCase().includes(q) || (r.student || '').toLowerCase().includes(q));
          });
        }) : studentsAll;
        if (q && !studentsMatch.length) return;

        const dateNode = buildNode('date', dateKey, studentsMatch.length + ' 位學生', (box) => {
          studentsMatch.forEach(studentSan => {
            const attempts = quizData[teacherKey][dateKey][studentSan] || {};
            const attemptKeys = Object.keys(attempts);
            const studentNode = buildNode('student', studentSan, attemptKeys.length + ' 筆作答', (box) => {
              attemptKeys.forEach(attemptKey => {
                const inner = attempts[attemptKey];
                if (inner && inner.score !== undefined) {
                  // 舊格式：attemptKey 直接是成績
                  const fullPath = quizScorePath(teacherKey, dateKey, studentSan, attemptKey);
                  box.appendChild(buildScoreRow({
                    name: inner.name || inner.student || attemptKey,
                    sub: [inner.student || '', inner.type || '', inner.time || '', inner.date || ''].filter(Boolean).join(' · '),
                    score: inner.score, total: inner.total,
                    editCb: () => editScore(fullPath, inner, renderQuiz),
                    delCb: () => deleteRecord(fullPath, inner.name || inner.student || attemptKey, renderQuiz)
                  }));
                } else {
                  // 新格式：attemptKey 下還有一層真正的成績
                  const innerKeys = inner && typeof inner === 'object' ? Object.keys(inner) : [];
                  const attemptNode = buildNode('attempt', attemptKey, innerKeys.length + ' 筆成績', (box) => {
                    innerKeys.forEach(innerKey => {
                      const rec = inner[innerKey] || {};
                      const fullPath = quizScorePath(teacherKey, dateKey, studentSan, attemptKey, innerKey);
                      box.appendChild(buildScoreRow({
                        name: rec.name || rec.student || innerKey,
                        sub: [rec.student || '', rec.type || '', rec.time || '', rec.date || ''].filter(Boolean).join(' · '),
                        score: rec.score, total: rec.total,
                        editCb: () => editScore(fullPath, rec, renderQuiz),
                        delCb: () => deleteRecord(fullPath, rec.name || rec.student || innerKey, renderQuiz)
                      }));
                    });
                  });
                  box.appendChild(attemptNode);
                  if (forceOpen) openNode(attemptNode);
                }
              });
            });
            box.appendChild(studentNode);
            if (forceOpen) openNode(studentNode);
          });
        });
        box.appendChild(dateNode);
        if (forceOpen) openNode(dateNode);
      });
    });
    tree.appendChild(teacherNode);
    if (forceOpen) openNode(teacherNode);
  });
}

/* ══════════ PVQCSCORES ══════════ */
async function loadPvqc() {
  const snap = await db.ref('PVQCSCORES').once('value');
  pvqcData = snap.exists() ? snap.val() : null;
  renderPvqc();
}

function renderPvqc() {
  const tree = document.getElementById('pvqc-tree');
  tree.replaceChildren();
  if (!pvqcData || !Object.keys(pvqcData).length) {
    document.getElementById('pvqc-empty').classList.remove('hidden');
    return;
  }
  document.getElementById('pvqc-empty').classList.add('hidden');
  const q = (document.getElementById('pvqc-search').value || '').trim().toLowerCase();
  const forceOpen = !!q;

  const PVQC_LABELS = { pvqc_scores1: '第一類', pvqc_scores2: '第二類', pvqc_scores3: '第三類', pvqc_totalscores: '總成績' };

  Object.keys(pvqcData).sort().forEach(rootKey => {
    let rootLabel = '資料區';

    // ── 已知結構一：_ttvs/{teacherSan}/ttvs/{attempt} ──
    if (rootKey === '_ttvs') {
      rootLabel = 'TTVS 教師即時成績';
const rootNode = buildNode('folder', rootKey, rootLabel, (box) => {
        Object.keys(pvqcData[rootKey] || {}).forEach(teacherSan => {
          const teacherNode = buildNode('teacher', teacherSan.replace(/,/g, '.'), '教師', (box) => {
            const sub = pvqcData[rootKey][teacherSan] || {};
            walkPvqc('PVQCSCORES/_ttvs/' + teacherSan, sub, box, q);
          });
          box.appendChild(teacherNode);
          if (forceOpen) openNode(teacherNode);
        });
      });
      tree.appendChild(rootNode);
      if (forceOpen) openNode(rootNode);
      return;
    }

    // ── 已知結構二：{teacherSan}/{dateKey}/{studentId}/{pvqc_scoresX|pvqc_totalscores}/{attempt} ──
    // hi@nasirlin,net 是第一層教師 key，其下是日期
    if (pvqcData[rootKey] && typeof pvqcData[rootKey] === 'object') {
      const firstLevel = pvqcData[rootKey];
      const firstKeys = Object.keys(firstLevel);
      // 檢查第二層是否為日期（有第三層學生ID）
      const looksLikeDateTree = firstKeys.length > 0 && firstKeys.every(dk => {
        const v = firstLevel[dk];
        if (!v || typeof v !== 'object') return false;
        return Object.keys(v).every(sk => {
          const sv = v[sk];
          return sv && typeof sv === 'object' && Object.keys(sv).some(tk => PVQC_LABELS[tk] !== undefined);
        });
      });
      if (looksLikeDateTree) {
        rootLabel = '教師遷移成績（' + rootKey.replace(/,/g, '.') + '）';
        const rootNode = buildNode('folder', rootKey.replace(/,/g, '.'), rootLabel, (box) => {
          firstKeys.sort().reverse().forEach(dateKey => {
            const dateNode = buildNode('date', dateKey, '日期', (box) => {
              Object.keys(firstLevel[dateKey] || {}).forEach(stuId => {
                const stuSub = firstLevel[dateKey][stuId] || {};
                const stuKeys = Object.keys(stuSub);
                const stuNode = buildNode('student', stuId, stuKeys.length + ' 類', (box) => {
                  stuKeys.forEach(subType => {
                    const label = PVQC_LABELS[subType] || subType;
                    const subNode = buildNode('folder', label, subType, (box) => {
                      walkPvqc('PVQCSCORES/' + rootKey + '/' + dateKey + '/' + stuId + '/' + subType, stuSub[subType], box, q);
                    });
                    box.appendChild(subNode);
                    if (forceOpen) openNode(subNode);
                  });
                });
                box.appendChild(stuNode);
                if (forceOpen) openNode(stuNode);
              });
            });
            box.appendChild(dateNode);
            if (forceOpen) openNode(dateNode);
          });
        });
        tree.appendChild(rootNode);
        if (forceOpen) openNode(rootNode);
        return;
      }
    }

    // ── 未知結構：通用巡覽 ──
    const rootNode = buildNode('folder', rootKey, rootLabel, (box) => {
      walkPvqc('PVQCSCORES/' + rootKey, pvqcData[rootKey], box, q);
    });
    tree.appendChild(rootNode);
    if (forceOpen) openNode(rootNode);
  });
}

function isScoreRecord(v) {
  return v && typeof v === 'object' && v.score !== undefined;
}

function walkPvqc(pathPrefix, data, parentBox, q) {
  if (!data || typeof data !== 'object') return;
  const keys = Object.keys(data);
  if (!keys.length) {
    parentBox.appendChild(buildText('（空）'));
    return;
  }

  if (keys.every(k => isScoreRecord(data[k]))) {
    keys.forEach(k => {
      const rec = data[k] || {};
      const haystack = [rec.student || '', rec.studentName || '', rec.studentId || '', rec.name || '', k].join(' ').toLowerCase();
      if (q && !haystack.includes(q)) return;
      const p = pathPrefix + '/' + k;
      parentBox.appendChild(buildScoreRow({
        name: rec.studentName || rec.studentId || rec.name || k,
        sub: [(rec.student || rec.studentId || ''), rec.time || rec.timestamp || rec.date || ''].filter(Boolean).join(' · '),
        score: rec.score, total: rec.total,
        editCb: () => editScore(p, rec, renderPvqc),
        delCb: () => deleteRecord(p, rec.studentName || rec.studentId || k, renderPvqc)
      }));
    });
    return;
  }

  keys.forEach(k => {
    const child = data[k];
    const childKeys = child && typeof child === 'object' ? Object.keys(child) : [];
    const recCount = childKeys.filter(ck => child[ck] && typeof child[ck] === 'object' && child[ck].score !== undefined).length;
    const node = buildNode('folder', k.replace(/,/g, '.'), recCount ? recCount + ' 筆成績' : childKeys.length + ' 項', (box) => {
      walkPvqc(pathPrefix + '/' + k, child, box, q);
    });
    parentBox.appendChild(node);
    if (q) openNode(node);
  });
}

/* ══════════ UI builders ══════════ */
const KIND_META = {
  teacher: { icon: '教', cls: 'k-teacher' },
  date:    { icon: '日', cls: 'k-date' },
  student: { icon: '生', cls: 'k-student' },
  attempt: { icon: '答', cls: 'k-attempt' },
  folder:  { icon: '⊞', cls: 'k-attempt' },
  blank:   { icon: '·', cls: 'k-date' }
};

function buildNode(kind, title, meta, buildChildren) {
  const km = KIND_META[kind] || KIND_META.blank;
  const wrap = document.createElement('div');
  wrap.className = 'tree-node';
  const head = document.createElement('div');
  head.className = 'node-head';
  head.innerHTML =
    '<svg class="caret" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd"/></svg>' +
    '<span class="node-icon ' + km.cls + '">' + km.icon + '</span>' +
    '<div class="node-main"><div class="node-title">' + esc(title) + '</div>' + (meta ? '<div class="node-meta">' + esc(meta) + '</div>' : '') + '</div>';
  wrap.appendChild(head);
  wrap._buildChildren = buildChildren || null;
  head.addEventListener('click', () => {
    if (wrap.querySelector('.node-children')) {
      collapseNode(wrap);
    } else {
      openNode(wrap);
    }
  });
  return wrap;
}

function openNode(wrap) {
  if (wrap.querySelector('.node-children')) {
    return;
  }
  const box = document.createElement('div');
  box.className = 'node-children';
  wrap.appendChild(box);
  const caret = wrap.querySelector('.caret');
  if (caret) caret.classList.add('open');
  if (wrap._buildChildren) wrap._buildChildren(box);
}

function collapseNode(wrap) {
  const children = wrap.querySelector('.node-children');
  if (children) children.remove();
  const caret = wrap.querySelector('.caret');
  if (caret) caret.classList.remove('open');
}

function buildText(t) {
  const d = document.createElement('div');
  d.className = 'no-match';
  d.textContent = t;
  return d;
}

function buildScoreRow(opts) {
  const row = document.createElement('div');
  row.className = 'score-row';
  const scoreNum = opts.score != null ? opts.score : '-';
  const totalHtml = opts.total != null ? '<span class="score-badge-total">/ ' + opts.total + '</span>' : '';
  row.innerHTML =
    '<div class="score-badge"><span class="score-badge-num">' + scoreNum + '</span>' + totalHtml + '</div>' +
    '<div class="score-info">' +
      '<div class="score-name">' + esc(opts.name) + '</div>' +
      (opts.sub ? '<div class="score-sub">' + esc(opts.sub) + '</div>' : '') +
    '</div>' +
    '<div class="score-actions">' +
      '<button class="btn-mini green btn-edit-score">修改</button>' +
      '<button class="btn-mini red btn-del-score">刪除</button>' +
    '</div>';
  row.querySelector('.btn-edit-score').addEventListener('click', opts.editCb);
  row.querySelector('.btn-del-score').addEventListener('click', opts.delCb);
  return row;
}

function expandAllNodes(container) {
  // 由上而下遞迴展開
  const stack = [container];
  while (stack.length) {
    const el = stack.pop();
    el.querySelectorAll(':scope > .tree-node').forEach(node => {
      openNode(node);
      const box = node.querySelector('.node-children');
      if (box) stack.push(box);
    });
  }
}

function collapseAllNodes(container) {
  container.querySelectorAll('.node-children').forEach(box => box.remove());
  container.querySelectorAll('.caret').forEach(c => c.classList.remove('open'));
}

function wireExpandButtons() {
  document.getElementById('btn-expand-all-quiz').onclick = () => expandAllNodes(document.getElementById('quiz-tree'));
  document.getElementById('btn-collapse-all').onclick = () => collapseAllNodes(document.getElementById('quiz-tree'));
  document.getElementById('btn-expand-all-pvqc').onclick = () => expandAllNodes(document.getElementById('pvqc-tree'));
  document.getElementById('btn-collapse-all-pvqc').onclick = () => collapseAllNodes(document.getElementById('pvqc-tree'));
}

document.getElementById('quiz-search').addEventListener('input', () => {
  document.getElementById('quiz-tree').replaceChildren();
  renderQuiz();
});
document.getElementById('pvqc-search').addEventListener('input', () => {
  document.getElementById('pvqc-tree').replaceChildren();
  renderPvqc();
});

loadQuiz();
loadPvqc();
wireExpandButtons();
</script>