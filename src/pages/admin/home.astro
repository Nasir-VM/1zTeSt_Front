    },
    {
      l: '收錄題目總數',
      v: s.totalQuestions,
      sub: '點擊前往題目管理 →',
      link: BP + '/admin/questions',
      bg: 'bg-purple-50 text-purple-600',
      icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>'
    },
    {
      l: '測驗紀錄筆數',
      v: s.totalScores,
      sub: '點擊前往成績管理 →',
      link: BP + '/admin/records',
      bg: 'bg-amber-50 text-amber-600',
      icon: '<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>'
    }
  ];
  const g = document.getElementById('stats-grid');
  if (!g) return;
  g.replaceChildren();
  cards.forEach((c) => {
    const card = document.createElement('div');
    card.className = 'stat-card-modern';
    card.innerHTML = `
      <div class="stat-icon-wrap ${c.bg}">${c.icon}</div>
      <div class="stat-info-modern">
        <p class="stat-label-modern">${c.l}</p>
        <p class="stat-value-modern">${c.v}</p>
        <p class="stat-sub-modern">${c.sub}</p>
      </div>
    `;
    if (c.link) {
      card.style.cursor = 'pointer';
      card.addEventListener('click', () => { window.location.href = c.link; });
    }
    g.appendChild(card);
  });
}

let allUsers = [];
let displayedCount = 0;
const PAGE_SIZE = 15;
function renderUsers(users, append) {
  if (!append) {
    allUsers = users;
    displayedCount = 0;
    document.getElementById('user-count').textContent = '共 ' + users.length + ' 位';
  }
  const rm = { admin: '管理員', teacher: '教師', student: '學生' };
  const cm = { admin: 'role-admin', teacher: 'role-teacher', student: 'role-student' };
  const tb = document.getElementById('users-list');
  const emp = document.getElementById('users-empty');
  const loadWrap = document.getElementById('load-more-wrap');

  if (!append) tb.replaceChildren();

  if (!allUsers.length && !append) { emp?.classList.remove('hidden'); loadWrap?.classList.add('hidden'); return; }
  emp?.classList.add('hidden');

  const start = append ? displayedCount : 0;
  const end = Math.min(start + PAGE_SIZE, allUsers.length);
  const slice = allUsers.slice(start, end);

  slice.forEach((u, i) => {
    const tr = document.createElement('tr');
    tr.className = 'hover:bg-slate-50/80 transition-colors';

    const idxTd = `<td class="py-3 px-4 text-xs font-medium text-slate-400 text-center">${start + i + 1}</td>`;
    const emailTd = `<td class="py-3 px-4 text-xs font-semibold text-slate-800 tracking-tight">${u.email}</td>`;
    const nameTd = `<td class="py-3 px-4 text-xs font-normal text-slate-600">${u.name || '-'}</td>`;
    const stunumTd = `<td class="py-3 px-4 text-xs font-normal text-slate-500">${u.stunum || '-'}</td>`;
    const roleBadge = `<span class="role-badge ${cm[u.role] || ''}">${rm[u.role] || u.role}</span>`;
    const roleTd = `<td class="py-3 px-4 text-center">${roleBadge}</td>`;

    let actionBtn = `<span class="text-xs text-slate-300">-</span>`;
    if (u.role !== 'admin') {
      actionBtn = `<button class="btn-action-del del-user-btn">刪除</button>`;
    }
    const actionTd = `<td class="py-3 px-4 text-center">${actionBtn}</td>`;

    tr.innerHTML = idxTd + emailTd + nameTd + stunumTd + roleTd + actionTd;

    const delBtn = tr.querySelector('.del-user-btn');
    if (delBtn) {
      delBtn.addEventListener('click', async () => {
        if (!confirm('確定刪除 ' + u.email + '？此操作無法復原！')) return;
        const san = window.sanitizeEmail(u.email);
        try {
          if (u.role === 'teacher') {
            await firebase.database().ref('1zTeStsys/Teacheraccount/' + san).remove();
            await firebase.database().ref('Teacherquestion/' + san).remove();
            const w = await firebase.database().ref('config/teacherWhitelist/' + san).once('value');
            if (w.exists()) await firebase.database().ref('config/teacherWhitelist/' + san).remove();
          } else if (u.role === 'student') {
            await firebase.database().ref('1zTeStsys/Studentaccount/' + san).remove();
          }
          showToast('已刪除 ' + u.email);
          cacheInvalidate('dashboard');
          loadDashboard();
        } catch (e) {
          showToast('刪除失敗');
        }
      });
    }

    tb.appendChild(tr);
  });

  displayedCount = end;
  if (displayedCount < allUsers.length) {
    loadWrap?.classList.remove('hidden');
  } else {
    loadWrap?.classList.add('hidden');
  }
}

document.getElementById('btn-load-more')?.addEventListener('click', () => {
  renderUsers(allUsers, true);
});

/* ── PVQC Whitelist ── */
document.getElementById('pvqc-email-input')?.addEventListener('keydown', (e) => {
  if (e.key === 'Enter') {
    e.preventDefault();
    document.getElementById('btn-pvqc-add')?.click();
  }
});

document.getElementById('btn-pvqc-add')?.addEventListener('click', async () => {
  const em = document.getElementById('pvqc-email-input').value.trim();
  if (!em) { showToast('請輸入 email'); return; }
  const san = window.sanitizeEmail(em);
  try {
    await firebase.database().ref('config/teacherWhitelist/' + san).set({
      email: em,
      addedBy: user.email,
      createdAt: new Date().toISOString()
    });
    await firebase.database().ref('1zTeStsys/Teacheraccount/' + san).update({
      email: em,
      updatedAt: new Date().toISOString()
    });
    showToast('已將 ' + em + ' 指派為權限教師');
    document.getElementById('pvqc-email-input').value = '';
    cacheInvalidate('whitelist');
    cacheInvalidate('dashboard');
    loadWhitelist();
    loadDashboard();
  } catch (e) { showToast('設定失敗'); }
});

let sTimer = null;
document.getElementById('user-search')?.addEventListener('input', function() {
  clearTimeout(sTimer);
  const q = this.value.toLowerCase().trim();
  sTimer = setTimeout(() => { renderUsers(q ? allUsers.filter(u => (u.email||'').toLowerCase().includes(q) || (u.name||'').toLowerCase().includes(q) || (u.stunum||'').toLowerCase().includes(q)) : allUsers); }, 150);
});

/* ── Auto-register admin ── */
async function ensureAdmin() {
  if (!user?.email) return;
  const san = user.email.replace(/\./g, ',').replace(/#/g, ',').replace(/\$/g, ',').replace(/\//g, ',');
  const snap = await firebase.database().ref('config/admins/' + san).once('value');
  if (!snap.exists()) { await firebase.database().ref('config/admins/' + san).set({ email: user.email, createdAt: new Date().toISOString() }); cacheInvalidate('dashboard'); }
}

/* ── Whitelist ── */
async function loadWhitelist() {
  const cached = cacheGet('whitelist');
  if (cached) { renderWL(cached); return; }
  try {
    const snap = await firebase.database().ref('config/teacherWhitelist').once('value');
    const data = snap.exists() ? snap.val() : null;
    if (data) cacheSet('whitelist', data);
    renderWL(data);
  } catch(e) {}
}

function renderWL(data) {
  const tb = document.getElementById('wl-tbody');
  if (!tb) return;
  tb.replaceChildren();
  const emp = document.getElementById('wl-empty');
  if (!data || Object.keys(data).length === 0) {
    emp?.classList.remove('hidden');
    return;
  }
  emp?.classList.add('hidden');
  Object.keys(data).forEach(k => {
    const d = data[k];
    const em = d.email || k.replace(/,/g, '.');
    const tr = document.createElement('tr');
    tr.className = 'hover:bg-slate-50/80 transition-colors';

    const emailTd = `<td class="py-3 px-4 font-semibold text-slate-800">${em}</td>`;
    const adminTd = `<td class="py-3 px-4 text-slate-500">${d.addedBy || '—'}</td>`;
    const timeTd = `<td class="py-3 px-4 text-slate-500">${d.createdAt ? new Date(d.createdAt).toLocaleDateString('zh-TW') : '—'}</td>`;
    const actionTd = `<td class="py-3 px-4 text-center"><button class="btn-action-del btn-revoke-btn">解除權限</button></td>`;

    tr.innerHTML = emailTd + adminTd + timeTd + actionTd;
    const btnRevoke = tr.querySelector('.btn-revoke-btn');
    if (btnRevoke) {
      btnRevoke.addEventListener('click', async () => {
        if (!confirm('確定解除 ' + em + ' 的教師管理權限？')) return;
        try {
          await firebase.database().ref('config/teacherWhitelist/' + k).remove();
          showToast('已解除 ' + em + ' 的教師權限');
          cacheInvalidate('whitelist');
          cacheInvalidate('dashboard');
          loadWhitelist();
          loadDashboard();
        } catch(e) {
          showToast('解除失敗');
        }
      });
    }
    tb.appendChild(tr);
  });
}

/* ── Logout ── */
async function doLogout() { try { await firebase.auth().signOut(); } catch(e) {} localStorage.removeItem('fb_user'); window.location.href = BP + '/admin/login'; }
document.getElementById('dropdown-logout')?.addEventListener('click', doLogout);

ensureAdmin().then(loadDashboard);
</script>
