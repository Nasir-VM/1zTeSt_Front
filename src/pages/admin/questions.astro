---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="題目管理">
  <div id="auth-guard" style="position:fixed;inset:0;z-index:9999;background:#fff;display:flex;align-items:center;justify-content:center"></div>

  <!-- Top Navbar -->
  <nav class="topnav">
    <div class="topnav-inner">
      <div class="topnav-left">
        <a href="/" class="topnav-logo">1zTeSt</a>
        <span class="topnav-divider"></span>
        <span class="topnav-subtitle">管理後台</span>
      </div>
      <div class="topnav-tabs">
        <a href="/admin/home" class="topnav-tab">總覽</a>
        <a href="/admin/questions" class="topnav-tab active">題目</a>
        <a href="/admin/records" class="topnav-tab">成績</a>
        <a href="/ttvs/admin" class="topnav-tab">TTVS</a>
        <a href="/" class="topnav-tab">回首頁</a>
      </div>
      <div class="topnav-right">
        <div class="profile-menu">
          <button id="profile-trigger" class="profile-btn">
            <div id="avatar-circle" class="avatar"></div>
            <svg class="chevron" id="profile-chevron" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd"/></svg>
          </button>
          <div id="profile-dropdown" class="dropdown">
            <div class="dropdown-head">
              <p class="dropdown-label">管理員</p>
              <p id="dropdown-email" class="dropdown-email"></p>
            </div>
            <button id="dropdown-logout" class="dropdown-item danger">登出</button>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Content -->
  <main class="main-content w-full flex-1">
    <div class="section-bar">
      <h2 class="section-title">題目管理</h2>
      <span class="section-count">瀏覽所有教師的題庫</span>
    </div>

    <!-- Teacher selector + chapters -->
    <div class="panel p-5 mb-6 border border-slate-200 shadow-sm bg-white" style="border-radius:0px;">
      <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-200 flex-wrap gap-3">
        <div>
          <h2 class="text-sm font-bold text-slate-800">選擇教師</h2>
          <p class="text-xs text-slate-500 mt-0.5">點擊章節卡片以查看題目</p>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
          <select id="teacher-select" class="border border-slate-200 px-3 py-2 text-xs text-slate-700 focus:border-slate-800 focus:outline-none flex-1 sm:w-72 bg-white" style="border-radius:0px;">
            <option value="">載入中...</option>
          </select>
        </div>
      </div>
      <div id="chapter-grid" class="stats-grid"></div>
      <p id="chapter-empty" class="empty-msg hidden">該教師尚無章節</p>
    </div>

    <!-- Questions list -->
    <div class="panel !rounded-none border border-slate-200 shadow-none overflow-hidden" style="border-radius:0px;">
      <div class="panel-search border-b border-slate-200 p-3 bg-slate-50/50">
        <div class="flex items-center justify-between flex-wrap gap-3">
          <div>
            <h2 class="text-sm font-bold text-slate-800" id="q-current-title">題目列表</h2>
            <p class="text-xs text-slate-500 mt-0.5" id="q-current-meta"></p>
          </div>
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <input id="q-search" type="text" placeholder="搜尋題目文字..." class="w-full border border-slate-200 bg-white py-2 pl-3 pr-4 text-xs text-slate-700 placeholder:text-slate-400 focus:border-slate-800 focus:outline-none transition-colors" style="border-radius:0px;max-width:260px;" />
          </div>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm font-sans border-collapse">
          <thead>
            <tr class="bg-slate-100/80 border-b border-slate-200 text-xs font-bold text-slate-600 uppercase tracking-wider">
              <th class="py-3.5 px-4 w-10 text-center">#</th>
              <th class="py-3.5 px-4">題目</th>
              <th class="py-3.5 px-4">選項</th>
              <th class="py-3.5 px-4">答案</th>
              <th class="py-3.5 px-4 text-center w-20">操作</th>
            </tr>
          </thead>
          <tbody id="q-tbody" class="divide-y divide-slate-200"></tbody>
        </table>
      </div>
      <p id="q-empty" class="empty-msg hidden">請先選擇教師與章節</p>
    </div>
  </main>

  <div id="toast" class="toast-wrap"></div>
</Layout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap');
  /* ── Reset & Base ── */
  :root { --black: #111; --gray-1: #333; --gray-2: #666; --gray-3: #999; --gray-4: #ccc; --gray-bg: #f5f5f5; --white: #fff; --border: #e5e5e5; --radius: 12px; }
  body { font-family: "Noto Sans TC", "PingFang TC", "Microsoft JhengHei", sans-serif; }

  /* ── Top Nav ── */
  .topnav { position: sticky; top: 0; z-index: 40; background: rgba(255,255,255,0.92); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); }
  .topnav-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; height: 56px; padding: 0 24px; }
  .topnav-left { display: flex; align-items: center; gap: 12px; }
  .topnav-logo { font-size: 18px; font-weight: 700; color: var(--black); text-decoration: none; letter-spacing: -0.02em; }
  .topnav-divider { width: 1px; height: 18px; background: var(--gray-4); }
  .topnav-subtitle { font-size: 13px; color: var(--gray-3); font-weight: 500; }
  .topnav-tabs { display: flex; align-items: center; gap: 8px; }
  .topnav-tab {
    position: relative;
    font-size: 13px;
    font-weight: 500;
    color: var(--gray-3, #64748b);
    background: transparent;
    border: none;
    padding: 16px 10px;
    cursor: pointer;
    transition: color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }
  .topnav-tab::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2.5px;
    background: #16a34a;
    border-radius: 9999px;
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .topnav-tab:hover { color: #16a34a; }
  .topnav-tab:hover::after { width: 100%; left: 0; }
  .topnav-tab.active { color: #16a34a; font-weight: 600; }
  .topnav-tab.active::after { width: 100%; left: 0; }
  .topnav-right { display: flex; align-items: center; gap: 16px; }
  .profile-menu { position: relative; }
  .profile-btn { display: flex; align-items: center; gap: 8px; cursor: pointer; background: none; border: none; padding: 4px 8px; border-radius: 8px; transition: background 0.15s; }
  .profile-btn:hover { background: var(--gray-bg); }
  .avatar { width: 30px; height: 30px; border-radius: 8px; background: var(--black); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 600; overflow: hidden; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .chevron { width: 14px; height: 14px; color: var(--gray-4); transition: transform 0.2s; }
  .chevron.open { transform: rotate(180deg); }
  .dropdown { position: absolute; right: 0; top: calc(100% + 8px); width: 240px; background: #fff; border: 1px solid var(--border); border-radius: var(--radius); box-shadow: 0 8px 32px rgba(0,0,0,0.08); opacity: 0; pointer-events: none; transform: translateY(-4px); transition: all 0.2s cubic-bezier(0.16,1,0.3,1); }
  .dropdown.open { opacity: 1; pointer-events: auto; transform: translateY(0); }
  .dropdown-head { padding: 14px 16px; border-bottom: 1px solid var(--border); }
  .dropdown-label { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--gray-3); }
  .dropdown-email { margin-top: 2px; font-size: 13px; font-weight: 500; color: var(--gray-1); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dropdown-item { display: block; width: 100%; text-align: left; padding: 10px 16px; font-size: 13px; color: var(--gray-2); background: none; border: none; cursor: pointer; transition: background 0.15s; }
  .dropdown-item:hover { background: var(--gray-bg); }
  .dropdown-item.danger { color: #e53e3e; }
  .dropdown-item.danger:hover { background: #fff5f5; }

  /* ── Main Content ── */
  .main-content { max-width: 1200px; margin: 0 auto; padding: 32px 24px; }

  /* ── Section Bar ── */
  .section-bar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
  .section-title { font-size: 15px; font-weight: 600; color: var(--black); }
  .section-count { font-size: 12px; color: var(--gray-3); }

  /* ── Stats Grid — chapter cards ── */
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 14px; }
  .chapter-card {
    background: #fff; border: 1px solid var(--border); border-radius: 16px;
    padding: 16px 18px; cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    display: flex; flex-direction: column; gap: 6px;
  }
  .chapter-card:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(0,0,0,0.05); border-color: #16a34a; }
  .chapter-card.sel { border-color: #16a34a; background: #f7fef9; box-shadow: 0 0 0 2px rgba(22,163,74,0.12); }
  .cc-title { font-size: 14px; font-weight: 600; color: var(--black); word-break: break-all; }
  .cc-meta { font-size: 11px; color: var(--gray-3); }
  .cc-badge { align-self: flex-start; font-size: 10px; font-weight: 600; padding: 1px 8px; border-radius: 9999px; letter-spacing: 0.02em; }
  .cc-badge.open { background: #f0fdf4; color: #15803d; border: 1px solid #dcfce7; }
  .cc-badge.closed { background: #f1f5f9; color: #64748b; border: 1px solid #e2e8f0; }

  /* ── Panel ── */
  .panel { background: #fff; border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: box-shadow 0.2s; }
  .panel:hover { box-shadow: 0 2px 12px rgba(0,0,0,0.04); }
  .panel.p-5 { padding: 20px; }
  .panel-search { padding: 12px 16px; border-bottom: 1px solid var(--border); }

  .empty-msg { padding: 40px; text-align: center; font-size: 13px; color: var(--gray-3); }

  /* ── Question rows ── */
  .q-cell { max-width: 420px; }
  .q-text { font-size: 13px; color: var(--gray-1); line-height: 1.6; word-break: break-word; }
  .q-opts { font-size: 11px; color: var(--gray-3); line-height: 1.6; word-break: break-word; white-space: pre-line; }
  .q-ans { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; background: #f0fdf4; color: #15803d; border: 1px solid #dcfce7; border-radius: 6px; font-size: 12px; font-weight: 600; }
  .del-btn { padding: 4px 10px; font-size: 11px; font-weight: 500; color: #dc2626; border: 1px solid #fca5a5; background: #fff; border-radius: 0px; cursor: pointer; transition: all 0.15s; }
  .del-btn:hover { background: #fff5f5; border-color: #feb2b2; }

  /* ── Toast ── */
  .toast-wrap { position: fixed; bottom: 24px; right: 24px; z-index: 50; display: flex; flex-direction: column; gap: 8px; }
  .toast-item { padding: 12px 20px; border-radius: 10px; background: var(--black); color: #fff; font-size: 13px; font-weight: 500; box-shadow: 0 8px 32px rgba(0,0,0,0.12); animation: toastIn 0.3s cubic-bezier(0.16,1,0.3,1) forwards; }
  .toast-item.out { animation: toastOut 0.2s forwards; }
  @keyframes toastIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes toastOut { from { opacity: 1; } to { opacity: 0; transform: translateY(8px); } }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .topnav-inner { padding: 0 16px; height: 50px; }
    .topnav-subtitle { display: none; }
    .topnav-divider { display: none; }
    .topnav-tabs { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; flex-shrink: 1; min-width: 0; }
    .topnav-tabs::-webkit-scrollbar { display: none; }
    .topnav-tab { white-space: nowrap; padding: 6px 10px; font-size: 12px; }
    .topnav-right { gap: 8px; }
    .main-content { padding: 20px 16px; }
    .stats-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; }
  }
</style>

<script is:inline>
const BP = (typeof window !== 'undefined' && window.BASE_PATH) ? window.BASE_PATH : '';
const user = JSON.parse(localStorage.getItem('fb_user') || 'null');
if (!user || !user.email || !window.isAdminEmail(user.email)) {
  window.location.href = BP + '/admin/login';
} else {
  document.getElementById('auth-guard')?.remove();
}

const avatarEl = document.getElementById('avatar-circle');
const dropdownEmail = document.getElementById('dropdown-email');
if (user?.email) {
  if (user.photoURL) {
    avatarEl.innerHTML = '<img src="' + user.photoURL + '" alt="avatar" style="width:100%;height:100%;object-fit:cover;border-radius:inherit;" />';
  } else {
    avatarEl.textContent = user.email[0].toUpperCase();
  }
  dropdownEmail.textContent = user.email;
}
let ddOpen = false;
const dd = document.getElementById('profile-dropdown');
const chev = document.getElementById('profile-chevron');
document.getElementById('profile-trigger')?.addEventListener('click', e => { e.stopPropagation(); ddOpen = !ddOpen; dd.classList.toggle('open', ddOpen); chev.classList.toggle('open', ddOpen); });
document.addEventListener('click', () => { if (ddOpen) { ddOpen = false; dd.classList.remove('open'); chev.classList.remove('open'); } });
dd?.addEventListener('click', e => e.stopPropagation());
document.getElementById('dropdown-logout')?.addEventListener('click', async () => {
  try { await window.fbAuth.signOut(); } catch(e) {}
  localStorage.removeItem('fb_user'); localStorage.removeItem('last_activity');
  window.location.href = BP + '/';
});

function showToast(msg) {
  const w = document.getElementById('toast');
  const el = document.createElement('div');
  el.className = 'toast-item'; el.textContent = msg;
  w.appendChild(el);
  setTimeout(() => { el.classList.add('out'); setTimeout(() => el.remove(), 220); }, 2800);
}

function esc(s) {
  if (s === null || s === undefined) return '';
  return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

const db = window.fbDB;
let TEACHERS = null;      // Teacherquestion snapshot
let QUESTIONDATA = {};    // { teacherKey: { chapterId: {...} } } — lazy per-chapter cache
let curSel = null;        // { teacherKey, chapterId, chapter }
let qFilter = '';
let qLoading = false;

/* ── Load teachers (lightweight) first ── */
async function loadAll() {
  try {
    showToast('載入中...');
    const tSnap = await db.ref('Teacherquestion').once('value');
    TEACHERS = tSnap.exists() ? tSnap.val() : null;
    renderTeacherSelect();
    showToast('題庫清單已載入');
  } catch (e) {
    console.error(e);
    showToast('載入失敗');
  }
}

function renderTeacherSelect() {
  const sel = document.getElementById('teacher-select');
  sel.replaceChildren();
  if (!TEACHERS || !Object.keys(TEACHERS).length) {
    sel.innerHTML = '<option value="">尚無教師題庫</option>';
    return;
  }
  const keys = Object.keys(TEACHERS);
  sel.innerHTML = '<option value="">選擇教師（' + keys.length + ' 位）</option>';
  keys.forEach(k => {
    const o = document.createElement('option');
    o.value = k;
    o.textContent = k.replace(/,/g, '.');
    sel.appendChild(o);
  });
}

function renderChapters(teacherKey) {
  const grid = document.getElementById('chapter-grid');
  const empty = document.getElementById('chapter-empty');
  grid.replaceChildren();
  const t = TEACHERS && TEACHERS[teacherKey];
  if (!t) {
    document.getElementById('q-tbody').replaceChildren();
    empty.classList.remove('hidden');
    empty.textContent = '該教師尚無章節';
    return;
  }
  const chapters = t.chapters || {};
  const chKeys = Object.keys(chapters);
  if (!chKeys.length) {
    document.getElementById('q-tbody').replaceChildren();
    empty.classList.remove('hidden');
    return;
  }
  empty.classList.add('hidden');
  chKeys.forEach(chId => {
    const ch = chapters[chId] || {};
    const card = document.createElement('div');
    card.className = 'chapter-card' + (curSel && curSel.chapterId === chId ? ' sel' : '');
    const openBadge = ch.open ? '<span class="cc-badge open">開放</span>' : '<span class="cc-badge closed">未開放</span>';
    card.innerHTML =
      '<div class="cc-title">' + esc(ch.name || chId) + '</div>' +
      '<div class="cc-meta">' + esc(ch.subject || '') + '　・　' + (ch.question_count || 0) + ' 題</div>' +
      openBadge;
    card.addEventListener('click', () => {
      curSel = { teacherKey, chapterId: chId, chapter: ch };
      renderChapters(teacherKey);
      loadQuestions();
    });
    grid.appendChild(card);
  });
}

async function loadQuestions() {
  const tbody = document.getElementById('q-tbody');
  const empty = document.getElementById('q-empty');
  tbody.replaceChildren();
  if (!curSel) {
    empty.classList.remove('hidden');
    empty.textContent = '請先選擇教師與章節';
    return;
  }
  const tk = curSel.teacherKey, chId = curSel.chapterId;
  document.getElementById('q-current-title').textContent = curSel.chapter.name || chId;
  document.getElementById('q-current-meta').textContent = (curSel.chapter.subject || '') + '　・　載入中...';
  empty.classList.remove('hidden');
  empty.textContent = '載入中...';

  // 若未快取才抓取（lazy，單章節快）
  if (!QUESTIONDATA[tk] || !QUESTIONDATA[tk][chId]) {
    qLoading = true;
    const snap = await db.ref('QuestionData/' + tk + '/' + chId).once('value');
    qLoading = false;
    if (!QUESTIONDATA[tk]) QUESTIONDATA[tk] = {};
    QUESTIONDATA[tk][chId] = snap.exists() ? snap.val() : null;
  }
  renderQuestions();
}

function formatOptions(q) {
  const lines = [];
  ['A', 'B', 'C', 'D', 'E', 'F'].forEach(l => { if (q[l] !== undefined && q[l] !== null && q[l] !== '') lines.push(l + '. ' + q[l]); });
  return lines.join('\n');
}

function renderQuestions() {
  const tbody = document.getElementById('q-tbody');
  const empty = document.getElementById('q-empty');
  tbody.replaceChildren();
  if (!curSel) {
    empty.classList.remove('hidden');
    empty.textContent = '請先選擇教師與章節';
    return;
  }
  const data = QUESTIONDATA[curSel.teacherKey] && QUESTIONDATA[curSel.teacherKey][curSel.chapterId];
  document.getElementById('q-current-title').textContent = curSel.chapter.name || curSel.chapterId;
  document.getElementById('q-current-meta').textContent =
    (curSel.chapter.subject || '') + '　・　' + (data ? Object.keys(data).length : 0) + ' 題';
  if (!data || !Object.keys(data).length) {
    empty.classList.remove('hidden');
    empty.textContent = '此章節尚無題目';
    return;
  }
  empty.classList.add('hidden');
  const keys = Object.keys(data);
  const fq = qFilter.toLowerCase();
  let idx = 0;
  keys.forEach(qKey => {
    const q = data[qKey] || {};
    const text = q.question || '';
    if (fq && !text.toLowerCase().includes(fq)) return;
    idx++;
    const tr = document.createElement('tr');
    tr.className = 'hover:bg-slate-50 transition-colors border-b border-slate-200 align-top';
    tr.innerHTML =
      '<td class="py-3 px-4 text-xs text-slate-400 text-center">' + idx + '</td>' +
      '<td class="py-3 px-4 q-cell"><div class="q-text">' + esc(text) + '</div>' +
        (q.explanation ? '<div class="q-opts mt-1">詳解：' + esc(q.explanation) + '</div>' : '') + '</td>' +
      '<td class="py-3 px-4 q-cell"><div class="q-opts">' + esc(formatOptions(q)) + '</div></td>' +
      '<td class="py-3 px-4"><span class="q-ans">' + esc(q.answer || '-') + '</span></td>' +
      '<td class="py-3 px-4 text-center"><button class="del-btn" type="button">刪除</button></td>';
    const delBtn = tr.querySelector('.del-btn');
    const fullPath = 'QuestionData/' + curSel.teacherKey + '/' + curSel.chapterId + '/' + qKey;
    delBtn.addEventListener('click', async () => {
      if (!confirm('確定刪除這題？此操作無法復原！')) return;
      try {
        await db.ref(fullPath).remove();
        const qc = Number(curSel.chapter.question_count || 0);
        const newCount = Math.max(0, qc - 1);
        await db.ref('Teacherquestion/' + curSel.teacherKey + '/chapters/' + curSel.chapterId + '/question_count').set(newCount);
        curSel.chapter.question_count = newCount;
        if (QUESTIONDATA[curSel.teacherKey] && QUESTIONDATA[curSel.teacherKey][curSel.chapterId]) delete QUESTIONDATA[curSel.teacherKey][curSel.chapterId][qKey];
        renderChapters(curSel.teacherKey);
        renderQuestions();
        showToast('已刪除題目');
      } catch (e) { console.error(e); showToast('刪除失敗'); }
    });
    tbody.appendChild(tr);
  });
  if (!idx) {
    empty.classList.remove('hidden');
    empty.textContent = fq ? '沒有符合搜尋的題目' : '此章節尚無題目';
  }
}

document.getElementById('teacher-select').addEventListener('change', e => {
  const v = e.target.value;
  document.getElementById('q-tbody').replaceChildren();
  document.getElementById('q-empty').classList.remove('hidden');
  document.getElementById('q-empty').textContent = v ? '請選擇章節' : '請先選擇教師';
  renderChapters(v);
});

let qTimer = null;
document.getElementById('q-search').addEventListener('input', function() {
  clearTimeout(qTimer);
  qFilter = this.value;
  qTimer = setTimeout(renderQuestions, 150);
});

loadAll();
</script>