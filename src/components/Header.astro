---
const { isLoggedIn = false, role = '' } = Astro.props;
---
<header class="fixed left-0 right-0 top-0 z-50 border-b border-slate-100/60 bg-white/80 backdrop-blur-xl supports-[backdrop-filter]:bg-white/60">
  <div class="mx-auto flex h-16 max-w-[1080px] items-center justify-between px-6">
    <a href="/" class="font-logo text-lg transition hover:opacity-80" style="color: var(--color-primary);">
      1zTeSt
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1 text-sm">
      <!-- Logged-out links -->
      <div id="nav-logged-out" class="flex items-center gap-1">
        <a href="/guide" class="nav-link">如何開始</a>
        <a href="/login/teacher" class="nav-link">教師登入</a>
      </div>
      <!-- Teacher links (shown when role=teacher) -->
      <div id="nav-teacher-links" class="hidden items-center gap-1">
        <a href="/teacher/" class="nav-link">題庫管理</a>
        <a href="/teacher/scores" class="nav-link">成績管理</a>
        <a href="/quiz/" class="nav-link">回到學生頁面</a>
      </div>
      <!-- Logged-in user section -->
      <div id="nav-logged-in" class="hidden items-center gap-2">
        <div id="header-avatar-circle" class="h-7 w-7 rounded-full bg-slate-200 flex items-center justify-center text-xs font-bold text-slate-600 overflow-hidden shrink-0"></div>
        <span id="header-welcome-name" class="text-slate-600 font-medium whitespace-nowrap"></span>
        <button id="header-logout-btn" class="nav-link !text-red-500 hover:!text-red-600 !text-xs">登出</button>
      </div>
    </nav>

    <!-- Mobile menu button -->
    <button id="mobile-menu-btn" class="block md:hidden text-slate-500 hover:text-green-600 focus:outline-none" aria-label="選單">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon-path" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden absolute left-0 right-0 top-16 border-b border-slate-100 bg-white/95 px-6 py-4 shadow-md backdrop-blur-md">
    <div class="flex flex-col gap-3 text-sm">
      <!-- Mobile: logged-out -->
      <div id="mobile-nav-logged-out">
        <a href="/guide" class="mobile-nav-link">如何開始</a>
        <a href="/login/teacher" class="mobile-nav-link">教師登入</a>
      </div>
      <!-- Mobile: teacher links -->
      <div id="mobile-nav-teacher-links" class="hidden">
        <a href="/teacher/" class="mobile-nav-link">題庫管理</a>
        <a href="/teacher/scores" class="mobile-nav-link">成績管理</a>
        <a href="/quiz/" class="mobile-nav-link">回到學生頁面</a>
      </div>
      <!-- Mobile: logged-in -->
      <div id="mobile-nav-logged-in" class="hidden flex flex-col gap-3">
        <div class="flex items-center gap-2">
          <div id="mobile-header-avatar" class="h-7 w-7 rounded-full bg-slate-200 flex items-center justify-center text-xs font-bold text-slate-600 overflow-hidden shrink-0"></div>
          <span id="mobile-header-welcome" class="text-slate-600 font-medium"></span>
        </div>
        <button id="mobile-header-logout-btn" class="mobile-nav-link !text-red-500 hover:!text-red-600 text-left">登出</button>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-link {
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    color: #64748b;
    transition: color 0.15s, background 0.15s;
    cursor: pointer;
    background: none;
    border: none;
    font: inherit;
  }
  .nav-link:hover {
    color: #16a34a;
    background: rgba(22,163,74,0.06);
  }
  .mobile-nav-link {
    padding: 0.5rem 0;
    color: #64748b;
    transition: color 0.15s;
    cursor: pointer;
    background: none;
    border: none;
    font: inherit;
    text-align: left;
  }
  .mobile-nav-link:hover {
    color: #16a34a;
  }
  #header-avatar-circle img,
  #mobile-header-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script is:inline>
(function() {
  var logoutBtn = document.getElementById('header-logout-btn');
  var mobileLogoutBtn = document.getElementById('mobile-header-logout-btn');
  var btn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  var path = document.getElementById('menu-icon-path');

  function doLogout() {
    localStorage.removeItem('fb_user');
    localStorage.removeItem('last_activity');
    firebase.auth().signOut().then(function() {
      window.location.href = '/';
    }).catch(function() {
      window.location.href = '/';
    });
  }
  if (logoutBtn) logoutBtn.addEventListener('click', doLogout);
  if (mobileLogoutBtn) mobileLogoutBtn.addEventListener('click', doLogout);

  /* Read fb_user from localStorage and toggle nav */
  try {
    var fbUser = JSON.parse(localStorage.getItem('fb_user') || 'null');
    var loggedOutEl = document.getElementById('nav-logged-out');
    var loggedInEl = document.getElementById('nav-logged-in');
    var teacherLinks = document.getElementById('nav-teacher-links');
    var welcomeName = document.getElementById('header-welcome-name');
    var avatarCircle = document.getElementById('header-avatar-circle');
    var mLoggedOut = document.getElementById('mobile-nav-logged-out');
    var mLoggedIn = document.getElementById('mobile-nav-logged-in');
    var mTeacherLinks = document.getElementById('mobile-nav-teacher-links');
    var mAvatar = document.getElementById('mobile-header-avatar');
    var mWelcome = document.getElementById('mobile-header-welcome');

    if (fbUser && fbUser.email) {
      /* Detect page location first */
      var userRole = fbUser.role || 'student';
      var pathname = window.location.pathname;
      var isHomePage = pathname === '/' || pathname === '';
      var isQuizPage = pathname.indexOf('/quiz') === 0;

      /* Logged in — show user section */
      if (loggedInEl) { loggedInEl.classList.remove('hidden'); loggedInEl.classList.add('flex'); }
      if (mLoggedIn) { mLoggedIn.classList.remove('hidden'); mLoggedIn.classList.add('flex'); }

      /* On homepage: always show logged-out links (如何開始, 教師登入) */
      if (isHomePage) {
        if (loggedOutEl) { loggedOutEl.classList.remove('hidden'); loggedOutEl.classList.add('flex'); }
        if (mLoggedOut) { mLoggedOut.classList.remove('hidden'); }
      } else {
        if (loggedOutEl) loggedOutEl.classList.add('hidden');
        if (mLoggedOut) mLoggedOut.classList.add('hidden');
      }

      /* Role-based links — NOT on home page or quiz page */
      if (!isHomePage && !isQuizPage && (userRole === 'teacher' || userRole === 'admin')) {
        if (teacherLinks) { teacherLinks.classList.remove('hidden'); teacherLinks.classList.add('flex'); }
        if (mTeacherLinks) mTeacherLinks.classList.remove('hidden');
      }

      /* Welcome name */
      var displayName = fbUser.name || fbUser.email;
      if (welcomeName) welcomeName.textContent = '歡迎，' + displayName;
      if (mWelcome) mWelcome.textContent = '歡迎，' + displayName;

      /* Avatar */
      if (fbUser.photoURL) {
        if (avatarCircle) avatarCircle.innerHTML = '<img src="' + fbUser.photoURL + '" alt="avatar" />';
        if (mAvatar) mAvatar.innerHTML = '<img src="' + fbUser.photoURL + '" alt="avatar" />';
      } else {
        var initial = (fbUser.email || '?')[0].toUpperCase();
        if (avatarCircle) avatarCircle.textContent = initial;
        if (mAvatar) mAvatar.textContent = initial;
      }
    } else {
      /* Not logged in — show login links */
      if (loggedOutEl) loggedOutEl.classList.remove('hidden');
      if (loggedInEl) loggedInEl.classList.add('hidden');
      if (teacherLinks) teacherLinks.classList.add('hidden');
      if (mLoggedOut) mLoggedOut.classList.remove('hidden');
      if (mLoggedIn) mLoggedIn.classList.add('hidden');
      if (mTeacherLinks) mTeacherLinks.classList.add('hidden');
    }
  } catch(e) {}

  if (btn && menu) {
    btn.addEventListener('click', function() {
      var isHidden = menu.classList.contains('hidden');
      if (isHidden) { menu.classList.remove('hidden'); path.setAttribute('d', 'M6 18L18 6M6 6l12 12'); }
      else { menu.classList.add('hidden'); path.setAttribute('d', 'M4 6h16M4 12h16M4 18h16'); }
    });
  }
})();
</script>
