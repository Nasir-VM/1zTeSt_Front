---
const { isLoggedIn = false, role = '' } = Astro.props;
---
<header class="fixed left-0 right-0 top-0 z-50 border-b border-slate-100/70 bg-white/80 backdrop-blur-xl supports-[backdrop-filter]:bg-white/65 transition-all duration-300">
  <div class="mx-auto flex h-16 max-w-[1080px] items-center justify-between px-6">
    <a href="/" class="font-logo text-xl transition-all duration-200 hover:scale-105 active:scale-95" style="color: var(--color-primary, #16a34a);">
      1zTeSt
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1.5 text-sm">
      <!-- Logged-out links -->
      <div id="nav-logged-out" class="flex items-center gap-1">
        <a href="/guide" class="nav-link">如何開始</a>
        <a href="/login/teacher" class="nav-link">教師登入</a>
      </div>
      <!-- Teacher links (shown when role=teacher) -->
      <div id="nav-teacher-links" class="hidden items-center gap-1">
        <a href="/teacher/" class="nav-link">題庫管理</a>
        <a href="/teacher/scores" class="nav-link">成績管理</a>
        <a href="/quiz/" class="nav-link">回到學生頁面</a>
      </div>
      <!-- Logged-in user section -->
      <div id="nav-logged-in" class="hidden items-center gap-2.5 pl-2">
        <div id="header-avatar-circle" class="h-8 w-8 rounded-full bg-emerald-100 border border-emerald-200 flex items-center justify-center text-xs font-bold text-emerald-800 overflow-hidden shrink-0 shadow-sm"></div>
        <span id="header-welcome-name" class="text-slate-700 font-medium whitespace-nowrap text-xs"></span>
        <button id="header-logout-btn" class="nav-link !text-red-500 hover:!text-red-600 !text-xs !py-1 !px-2.5 rounded-lg hover:bg-red-50 transition">登出</button>
      </div>
    </nav>

    <!-- Animated Mobile Hamburger Button -->
    <button id="mobile-menu-btn" class="group relative flex h-10 w-10 md:hidden items-center justify-center rounded-xl bg-slate-50 border border-slate-200/80 text-slate-600 hover:text-green-600 hover:border-green-300 focus:outline-none transition-all duration-200 active:scale-90" aria-label="切換選單">
      <div class="relative flex h-4 w-5 flex-col justify-between overflow-hidden">
        <span id="bar-top" class="h-0.5 w-full rounded-full bg-slate-700 transition-all duration-300 ease-out origin-left"></span>
        <span id="bar-mid" class="h-0.5 w-full rounded-full bg-slate-700 transition-all duration-200 ease-out"></span>
        <span id="bar-bot" class="h-0.5 w-full rounded-full bg-slate-700 transition-all duration-300 ease-out origin-left"></span>
      </div>
    </button>
  </div>

  <!-- Mobile Backdrop Overlay -->
  <div id="mobile-backdrop" class="fixed inset-0 top-16 bg-slate-900/20 backdrop-blur-xs opacity-0 pointer-events-none transition-opacity duration-300 md:hidden z-40"></div>

  <!-- Animated Mobile Dropdown Menu -->
  <div id="mobile-menu" class="absolute left-0 right-0 top-16 border-b border-slate-100 bg-white/95 px-6 py-5 shadow-2xl backdrop-blur-2xl md:hidden z-50 opacity-0 pointer-events-none -translate-y-4 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)]">
    <div class="flex flex-col gap-2 text-sm">
      <!-- Mobile: logged-out -->
      <div id="mobile-nav-logged-out" class="flex flex-col gap-1.5">
        <a href="/guide" class="mobile-nav-item">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>如何開始</span>
        </a>
        <a href="/login/teacher" class="mobile-nav-item">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/></svg>
          <span>教師登入</span>
        </a>
      </div>
      <!-- Mobile: teacher links -->
      <div id="mobile-nav-teacher-links" class="hidden flex-col gap-1.5">
        <a href="/teacher/" class="mobile-nav-item">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          <span>題庫管理</span>
        </a>
        <a href="/teacher/scores" class="mobile-nav-item">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
          <span>成績管理</span>
        </a>
        <a href="/quiz/" class="mobile-nav-item">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          <span>回到學生頁面</span>
        </a>
      </div>
      <!-- Mobile: logged-in -->
      <div id="mobile-nav-logged-in" class="hidden flex-col gap-3 pt-2 border-t border-slate-100">
        <div class="flex items-center gap-3 p-2 bg-slate-50/80 rounded-xl">
          <div id="mobile-header-avatar" class="h-9 w-9 rounded-full bg-emerald-100 border border-emerald-200 flex items-center justify-center text-xs font-bold text-emerald-800 overflow-hidden shrink-0 shadow-xs"></div>
          <span id="mobile-header-welcome" class="text-slate-700 font-semibold text-sm"></span>
        </div>
        <button id="mobile-header-logout-btn" class="mobile-nav-item !text-red-500 hover:!bg-red-50">
          <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <span>登出</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-link {
    position: relative;
    padding: 0.5rem 0.875rem;
    color: #475569;
    font-weight: 500;
    transition: color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    background: transparent;
    border: none;
    font: inherit;
    display: inline-flex;
    align-items: center;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--color-primary, #16a34a);
    border-radius: 9999px;
    transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-link:hover {
    color: var(--color-primary, #16a34a);
  }
  .nav-link:hover::after {
    width: 75%;
    left: 12.5%;
  }

  .mobile-nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 12px;
    color: #334155;
    font-weight: 600;
    transition: all 0.2s ease;
    text-decoration: none;
  }
  .mobile-nav-item:hover {
    background: rgba(22, 163, 74, 0.08);
    color: #16a34a;
    transform: translateX(4px);
  }
  .mobile-nav-item:active {
    transform: scale(0.98);
  }

  /* Hamburger Active Animation Styles */
  #mobile-menu-btn.active #bar-top {
    transform: rotate(45deg) translate(2px, -2px);
    background-color: #16a34a;
  }
  #mobile-menu-btn.active #bar-mid {
    opacity: 0;
    transform: translateX(-10px);
  }
  #mobile-menu-btn.active #bar-bot {
    transform: rotate(-45deg) translate(2px, 2px);
    background-color: #16a34a;
  }

  /* Mobile Menu Open State */
  #mobile-menu.open {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }
  #mobile-backdrop.open {
    opacity: 1;
    pointer-events: auto;
  }

  #header-avatar-circle img,
  #mobile-header-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script is:inline>
(function() {
  var logoutBtn = document.getElementById('header-logout-btn');
  var mobileLogoutBtn = document.getElementById('mobile-header-logout-btn');
  var btn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  var backdrop = document.getElementById('mobile-backdrop');

  function doLogout() {
    localStorage.removeItem('fb_user');
    localStorage.removeItem('last_activity');
    if (window.firebase && window.firebase.auth) {
      window.firebase.auth().signOut().then(function() {
        window.location.href = '/';
      }).catch(function() {
        window.location.href = '/';
      });
    } else {
      window.location.href = '/';
    }
  }
  if (logoutBtn) logoutBtn.addEventListener('click', doLogout);
  if (mobileLogoutBtn) mobileLogoutBtn.addEventListener('click', doLogout);

  /* Read fb_user from localStorage and toggle nav */
  try {
    var fbUser = JSON.parse(localStorage.getItem('fb_user') || 'null');
    var loggedOutEl = document.getElementById('nav-logged-out');
    var loggedInEl = document.getElementById('nav-logged-in');
    var teacherLinks = document.getElementById('nav-teacher-links');
    var welcomeName = document.getElementById('header-welcome-name');
    var avatarCircle = document.getElementById('header-avatar-circle');
    var mLoggedOut = document.getElementById('mobile-nav-logged-out');
    var mLoggedIn = document.getElementById('mobile-nav-logged-in');
    var mTeacherLinks = document.getElementById('mobile-nav-teacher-links');
    var mAvatar = document.getElementById('mobile-header-avatar');
    var mWelcome = document.getElementById('mobile-header-welcome');

    if (fbUser && fbUser.email) {
      var userRole = fbUser.role || 'student';
      var pathname = window.location.pathname;
      var isHomePage = pathname === '/' || pathname === '';
      var isQuizPage = pathname.indexOf('/quiz') === 0;

      if (loggedInEl) { loggedInEl.classList.remove('hidden'); loggedInEl.classList.add('flex'); }
      if (mLoggedIn) { mLoggedIn.classList.remove('hidden'); mLoggedIn.classList.add('flex'); }

      if (isHomePage) {
        if (loggedOutEl) { loggedOutEl.classList.remove('hidden'); loggedOutEl.classList.add('flex'); }
        if (mLoggedOut) { mLoggedOut.classList.remove('hidden'); mLoggedOut.classList.add('flex'); }
      } else {
        if (loggedOutEl) loggedOutEl.classList.add('hidden');
        if (mLoggedOut) mLoggedOut.classList.add('hidden');
      }

      if (!isHomePage && !isQuizPage && (userRole === 'teacher' || userRole === 'admin')) {
        if (teacherLinks) { teacherLinks.classList.remove('hidden'); teacherLinks.classList.add('flex'); }
        if (mTeacherLinks) { mTeacherLinks.classList.remove('hidden'); mTeacherLinks.classList.add('flex'); }
      }

      var displayName = fbUser.name || fbUser.email;
      if (welcomeName) welcomeName.textContent = '歡迎，' + displayName;
      if (mWelcome) mWelcome.textContent = '歡迎，' + displayName;

      if (fbUser.photoURL) {
        if (avatarCircle) avatarCircle.innerHTML = '<img src="' + fbUser.photoURL + '" alt="avatar" />';
        if (mAvatar) mAvatar.innerHTML = '<img src="' + fbUser.photoURL + '" alt="avatar" />';
      } else {
        var initial = (fbUser.email || '?')[0].toUpperCase();
        if (avatarCircle) avatarCircle.textContent = initial;
        if (mAvatar) mAvatar.textContent = initial;
      }
    } else {
      if (loggedOutEl) loggedOutEl.classList.remove('hidden');
      if (loggedInEl) loggedInEl.classList.add('hidden');
      if (teacherLinks) teacherLinks.classList.add('hidden');
      if (mLoggedOut) { mLoggedOut.classList.remove('hidden'); mLoggedOut.classList.add('flex'); }
      if (mLoggedIn) mLoggedIn.classList.add('hidden');
      if (mTeacherLinks) mTeacherLinks.classList.add('hidden');
    }
  } catch(e) {}

  function toggleMenu(open) {
    var isOpen = typeof open === 'boolean' ? open : !btn.classList.contains('active');
    btn.classList.toggle('active', isOpen);
    menu.classList.toggle('open', isOpen);
    if (backdrop) backdrop.classList.toggle('open', isOpen);
  }

  if (btn && menu) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleMenu();
    });
    if (backdrop) {
      backdrop.addEventListener('click', function() {
        toggleMenu(false);
      });
    }
    document.addEventListener('click', function(e) {
      if (!menu.contains(e.target) && !btn.contains(e.target)) {
        toggleMenu(false);
      }
    });
  }
})();
</script>
