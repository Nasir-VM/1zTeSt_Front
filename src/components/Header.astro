---
const { isLoggedIn = false, role = '' } = Astro.props;
---
<header class="fixed left-0 right-0 top-0 z-50 border-b border-slate-100 bg-white/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-[1080px] items-center justify-between px-6">
    <a href="/" class="font-logo text-xl text-emerald-600 transition hover:opacity-80">
      1zTeSt
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
      <div id="nav-logged-out" class="flex items-center gap-1">
        <a href="/guide" class="nav-link">如何開始</a>
        <a href="/login/teacher" class="nav-link">教師登入</a>
      </div>
      <div id="nav-teacher-links" class="hidden items-center gap-1">
        <a href="/teacher/" class="nav-link">題庫管理</a>
        <a href="/teacher/scores" class="nav-link">成績管理</a>
        <a href="/quiz/" class="nav-link">回到學生頁面</a>
      </div>
      <div id="nav-logged-in" class="hidden items-center gap-2 pl-2">
        <div id="header-avatar-circle" class="h-7 w-7 rounded-full bg-slate-200 flex items-center justify-center text-xs font-semibold text-slate-700 overflow-hidden shrink-0"></div>
        <span id="header-welcome-name" class="text-slate-600 text-xs font-medium"></span>
        <button id="header-logout-btn" class="nav-link !text-red-500 hover:!text-red-600 !text-xs">登出</button>
      </div>
    </nav>

    <!-- Clean Hamburger Button -->
    <button id="mobile-menu-btn" class="md:hidden flex h-9 w-9 items-center justify-center rounded-lg text-slate-600 hover:bg-slate-100 active:scale-95 transition" aria-label="選單">
      <svg class="h-5 w-5 transition-transform duration-200" id="hamburger-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Floating Mobile Menu Card -->
  <div id="mobile-menu" class="hidden md:hidden absolute right-4 top-16 w-52 rounded-2xl border border-slate-200/80 bg-white/95 p-2 shadow-xl backdrop-blur-xl transition-all duration-150 ease-out origin-top-right scale-95 opacity-0">
    <div class="flex flex-col gap-1 text-sm font-medium text-slate-700">
      <div id="mobile-nav-logged-out" class="flex flex-col gap-1">
        <a href="/guide" class="mobile-item">如何開始</a>
        <a href="/login/teacher" class="mobile-item">教師登入</a>
      </div>
      <div id="mobile-nav-teacher-links" class="hidden flex-col gap-1">
        <a href="/teacher/" class="mobile-item">題庫管理</a>
        <a href="/teacher/scores" class="mobile-item">成績管理</a>
        <a href="/quiz/" class="mobile-item">學生測驗</a>
      </div>
      <div id="mobile-nav-logged-in" class="hidden flex-col gap-1 pt-1.5 border-t border-slate-100">
        <div class="flex items-center gap-2 px-3 py-1.5 text-xs text-slate-500">
          <div id="mobile-header-avatar" class="h-6 w-6 rounded-full bg-slate-200 flex items-center justify-center text-[10px] font-bold text-slate-700 overflow-hidden shrink-0"></div>
          <span id="mobile-header-welcome" class="truncate font-semibold text-slate-700"></span>
        </div>
        <button id="mobile-header-logout-btn" class="mobile-item !text-red-500 hover:!bg-red-50 text-left">登出</button>
      </div>
    </div>
  </div>
</header>

<style>
  .nav-link {
    padding: 0.5rem 0.875rem;
    color: #475569;
    transition: color 0.15s;
    background: transparent;
    border: none;
  }
  .nav-link:hover {
    color: #16a34a;
  }

  .mobile-item {
    padding: 8px 12px;
    border-radius: 10px;
    transition: background 0.15s, color 0.15s;
    text-decoration: none;
    color: #334155;
    display: block;
  }
  .mobile-item:hover {
    background: #f1f5f9;
    color: #0f172a;
  }
  .mobile-item:active {
    background: #e2e8f0;
  }

  #mobile-menu.open {
    opacity: 1;
    transform: scale(1);
  }

  #header-avatar-circle img,
  #mobile-header-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>

<script is:inline>
(function() {
  var logoutBtn = document.getElementById('header-logout-btn');
  var mobileLogoutBtn = document.getElementById('mobile-header-logout-btn');
  var btn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  var icon = document.getElementById('hamburger-icon');

  function doLogout() {
    localStorage.removeItem('fb_user');
    localStorage.removeItem('last_activity');
    if (window.firebase && window.firebase.auth) {
      window.firebase.auth().signOut().then(function() {
        window.location.href = '/';
      }).catch(function() {
        window.location.href = '/';
      });
    } else {
      window.location.href = '/';
    }
  }
  if (logoutBtn) logoutBtn.addEventListener('click', doLogout);
  if (mobileLogoutBtn) mobileLogoutBtn.addEventListener('click', doLogout);

  try {
    var fbUser = JSON.parse(localStorage.getItem('fb_user') || 'null');
    var loggedOutEl = document.getElementById('nav-logged-out');
    var loggedInEl = document.getElementById('nav-logged-in');
    var teacherLinks = document.getElementById('nav-teacher-links');
    var welcomeName = document.getElementById('header-welcome-name');
    var avatarCircle = document.getElementById('header-avatar-circle');
    var mLoggedOut = document.getElementById('mobile-nav-logged-out');
    var mLoggedIn = document.getElementById('mobile-nav-logged-in');
    var mTeacherLinks = document.getElementById('mobile-nav-teacher-links');
    var mAvatar = document.getElementById('mobile-header-avatar');
    var mWelcome = document.getElementById('mobile-header-welcome');

    if (fbUser && fbUser.email) {
      var userRole = fbUser.role || 'student';
      var pathname = window.location.pathname;
      var isHomePage = pathname === '/' || pathname === '';
      var isQuizPage = pathname.indexOf('/quiz') === 0;

      if (loggedInEl) { loggedInEl.classList.remove('hidden'); loggedInEl.classList.add('flex'); }
      if (mLoggedIn) { mLoggedIn.classList.remove('hidden'); mLoggedIn.classList.add('flex'); }

      if (isHomePage) {
        if (loggedOutEl) { loggedOutEl.classList.remove('hidden'); loggedOutEl.classList.add('flex'); }
        if (mLoggedOut) { mLoggedOut.classList.remove('hidden'); mLoggedOut.classList.add('flex'); }
      } else {
        if (loggedOutEl) loggedOutEl.classList.add('hidden');
        if (mLoggedOut) mLoggedOut.classList.add('hidden');
      }

      if (!isHomePage && !isQuizPage && (userRole === 'teacher' || userRole === 'admin')) {
        if (teacherLinks) { teacherLinks.classList.remove('hidden'); teacherLinks.classList.add('flex'); }
        if (mTeacherLinks) { mTeacherLinks.classList.remove('hidden'); mTeacherLinks.classList.add('flex'); }
      }

      var displayName = fbUser.name || fbUser.email;
      if (welcomeName) welcomeName.textContent = '歡迎，' + displayName;
      if (mWelcome) mWelcome.textContent = displayName;

      if (fbUser.photoURL) {
        if (avatarCircle) avatarCircle.innerHTML = '<img src="' + fbUser.photoURL + '" alt="avatar" />';
        if (mAvatar) mAvatar.innerHTML = '<img src="' + fbUser.photoURL + '" alt="avatar" />';
      } else {
        var initial = (fbUser.email || '?')[0].toUpperCase();
        if (avatarCircle) avatarCircle.textContent = initial;
        if (mAvatar) mAvatar.textContent = initial;
      }
    } else {
      if (loggedOutEl) loggedOutEl.classList.remove('hidden');
      if (loggedInEl) loggedInEl.classList.add('hidden');
      if (teacherLinks) teacherLinks.classList.add('hidden');
      if (mLoggedOut) { mLoggedOut.classList.remove('hidden'); mLoggedOut.classList.add('flex'); }
      if (mLoggedIn) mLoggedIn.classList.add('hidden');
      if (mTeacherLinks) mTeacherLinks.classList.add('hidden');
    }
  } catch(e) {}

  var isOpen = false;
  function setMenuState(open) {
    isOpen = open;
    if (isOpen) {
      menu.classList.remove('hidden');
      requestAnimationFrame(function() {
        menu.classList.add('open');
      });
      if (icon) icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />';
    } else {
      menu.classList.remove('open');
      setTimeout(function() {
        if (!isOpen) menu.classList.add('hidden');
      }, 150);
      if (icon) icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />';
    }
  }

  if (btn && menu) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      setMenuState(!isOpen);
    });

    document.addEventListener('click', function(e) {
      if (isOpen && !menu.contains(e.target) && !btn.contains(e.target)) {
        setMenuState(false);
      }
    });
  }
})();
</script>
